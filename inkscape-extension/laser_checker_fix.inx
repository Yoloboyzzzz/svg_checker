<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Laser Checker Fix</name>
  <id>nl.laserchecker.fix</id>
  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Laser Tools"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">laser_checker_fix.py</command>
  </script>
</inkscape-extension>
